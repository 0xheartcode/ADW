# Copy to .env and fill in. .env is gitignored - real endpoints and keys
# never belong in adw.py, which is the part you might share.
#
# Used by the `aider` worker, which talks to any OpenAI-compatible endpoint
# (llama.cpp, vLLM, or a LiteLLM proxy in front of them).

OPENAI_API_KEY=sk-replace-me
ADW_API_BASE=http://localhost:4000/v1
ADW_MODEL=openai/local
